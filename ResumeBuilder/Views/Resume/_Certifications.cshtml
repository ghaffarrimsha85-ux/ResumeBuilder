@model ResumeBuilder.Models.ResumeEditVM
@using ResumeBuilder.Models
@helper Row(Certification e)
{
    <div class="row-item">
        <button type="button" class="rm" title="Remove" onclick="removeRow(this)">&times;</button>
        <div class="grid">
            <div class="fg full"><label>Certificate Name</label><input type="text" data-f="CertificateName" value="@e.CertificateName" placeholder="e.g. Web Development Certificate" /></div>
            <div class="fg"><label>Issuing Authority</label><input type="text" data-f="Authority" value="@e.Authority" placeholder="e.g. Coursera" /></div>
            <div class="fg"><label>Year</label><input type="text" data-f="Year" value="@e.Year" placeholder="e.g. 2024" /></div>
        </div>
    </div>
}
<div class="step-head">
    <h3>Certifications</h3>
    <p>Add courses or certificates you have completed.</p>
</div>
<div class="list" id="list-certifications">
    @foreach (var e in Model.Certifications)
    {@Row(e)}
</div>
<button type="button" class="btn-add" onclick="addRow('certifications')">+ Add More</button>
<template id="tpl-certifications">
    @Row(new Certification())
</template>